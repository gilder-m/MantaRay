/target
**/*.rs.bk
*.pdb

# Scratch output from local runs
/out
/scratch

# User-supplied spectrum fixtures are opt-in; keep real data out of git by
# default (see crates/ortseam-formats/tests/fixtures/README.md).
crates/ortseam-formats/tests/fixtures/*
!crates/ortseam-formats/tests/fixtures/README.md
!crates/ortseam-formats/tests/fixtures/.gitkeep
