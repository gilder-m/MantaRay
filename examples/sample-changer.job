REM Count a rack of samples, changing between each one.
SET_DETECTOR 1
SET_PRESET_CLEAR
SET_PRESET_LIVE 600
LOOP 8
CLEAR
START
WAIT
FILL_BUFFER
SET_DETECTOR 0
DESCRIBE_SAMPLE "Rack position ???"
SAVE "SAMPLE???.CHN"
MARK_PEAKS
REPORT "SAMPLE???.RPT"
SET_DETECTOR 1
CHANGE_SAMPLE
WAIT_CHANGER
END_LOOP
